{
    "name": "vpndetection/laravel",
    "description": "Official Laravel middleware for the VPNDetection API. Detect VPNs, proxies, Tor, hosting and CDN visitors on every request.",
    "keywords": ["laravel", "middleware", "vpn", "vpn-detection", "proxy-detection", "tor", "ip-intelligence", "fraud-prevention"],
    "homepage": "https://vpndetection.io",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "vpndetection/vpndetection": "^4.3.2",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": { "psr-4": { "VPNDetection\\Laravel\\": "src/" } },
    "autoload-dev": { "psr-4": { "VPNDetection\\Laravel\\Tests\\": "tests/" } },
    "extra": {
        "laravel": {
            "providers": ["VPNDetection\\Laravel\\VPNDetectionServiceProvider"]
        }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
